workflow JudgeCandidate {
  input {
    eps: number
  }

  stage@entry Baseline {
    prompt: "Establish baseline score."
    output: {
      score: number
    }
  }

  stage Best {
    prompt: "Search for the best candidate."
    output: {
      score: number
    }
  }

  stage JudgeCandidate {
    prompt: "Judge the candidate against best."
    input: Baseline.score, Best.score
    output: {
      score: number?
    }
    transition if score - Best.score > eps => Accept
    transition if score > Best.score        => Confirm
    transition else                         => Reject
  }

  stage@exit Accept {
    prompt: "Accepted"
  }
  stage@exit Confirm {
    prompt: "Confirm"
  }
  stage@exit Reject {
    prompt: "Rejected"
  }
}
