workflow Test {
  stage@entry Start {
    prompt: "go"
    output: {
      ok: bool {
        true => Fin
        false => Fin
      }
    }
  }
  stage Orphan {
    prompt: "nobody reaches me"
    output: {
      x: string
    }
  }
  stage@exit Fin {
    prompt: "done"
    output: {
      summary: string
    }
  }
}
