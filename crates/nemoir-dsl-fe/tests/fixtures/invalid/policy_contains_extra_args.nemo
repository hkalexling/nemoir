workflow Test {
  input {
    cwd: path
  }

  policy {
    deny os.shell(command) if command.contains("x", cwd)
  }

  stage@entry Start {
    prompt: "start"
    requires: os.shell
    output: {
      x: string
    }
  }
  stage@exit Fin {
    prompt: "done"
    input: Start.x
    output: {
      summary: string
    }
  }
}
