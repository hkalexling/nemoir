workflow Test {
  input {
    cwd: path
  }

  policy {
    deny fs.write(path) if path or path.eq("candidate.py")
  }

  stage@entry Start {
    prompt: "start"
    requires: fs.write
    output: {
      x: string
    }
  }
  stage@exit Fin {
    prompt: "done"
    input: Start.x
    output: {
      summary: string
    }
  }
}
