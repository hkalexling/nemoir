workflow Test {
  stage@entry X {
    prompt: "x"
    input: Z.a
    output: {
      out: string
    }
  }
  stage Y {
    prompt: "y"
    input: Z.b
    output: {
      out: string
    }
  }
  stage Z {
    prompt: "z"
    input: X.out, Y.out
    output: {
      a: string
      b: string
    }
  }
  stage@exit Fin {
    prompt: "done"
  }
}
