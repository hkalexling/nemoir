workflow JsSandboxPositive {
  input {
    payload: json
  }

  // Dynamic source may be user-provided or produced by the preceding model
  // stage, but the static workflow always presents it for confirmation first.
  policy {
    before browser.js.sandbox(code) requires user.confirm
  }

  stage @entry GenerateCode {
    prompt: "Write JavaScript that transforms the JSON payload. The code is an async function body that receives `input` and must return a plain JSON object with a `result` key, e.g. `return { result: input.value + 1 };`. Top-level `await` and returning a Promise are both supported."
    output: {
      code: string
    }
  }

  stage RunSandbox {
    input: GenerateCode.code
    exec: browser.js.sandbox(
      code: GenerateCode.code,
      input: payload
    )
    output: {
      result: json
    }
  }

  stage @exit Done {
    prompt: "Sandbox result: @RunSandbox.result"
    output: {
      summary: string
    }
  }
}
