workflow JsRunModelErr {
  stage @entry Bad {
    prompt: "This stage tries to use browser.js.run which is deterministic-only"
    requires: browser.js.run
    output: {
      ok: bool { true => Done false => Done }
    }
  }

  stage @exit Done {
    prompt: "done"
    output: {
      summary: string
    }
  }
}
