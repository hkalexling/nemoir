workflow DetWithPrompt {
  stage @entry Run {
    prompt: "This prompt is documentation-only for a deterministic stage"
    exec: os.shell(command: "echo ok")
    output: {
      log: string
    }
  }

  stage @exit Fin {
    input: Run.log
    prompt: "Process result: @Run.log"
    output: {
      summary: string
    }
  }
}
