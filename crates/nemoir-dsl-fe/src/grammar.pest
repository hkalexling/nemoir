WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* ~ ("\n" | EOI) }

workflow = {
    SOI ~
    "workflow" ~ ident ~ "{" ~
    input_block? ~
    policy_block? ~
    stage* ~
    "}" ~
    EOI
}

ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

dotted_ident = @{ ident ~ ("." ~ ident)* }

type_base = { ident }

array_marker = { "[]" }
optional_marker = { "?" }

type_ref = {
    type_base ~ array_marker? ~ optional_marker?
}

input_block = {
    "input" ~ "{" ~
    input_field* ~
    "}"
}

input_field = { ident ~ ":" ~ type_ref }

policy_block = {
    "policy" ~ "{" ~
    (before_policy | deny_policy)* ~
    "}"
}

before_policy = {
    "before" ~ cap_call ~ "requires" ~ require_list
}

deny_policy = {
    "deny" ~ cap_call ~ "if" ~ policy_expr
}

cap_call = {
    dotted_ident ~ "(" ~ ident ~ ("," ~ ident)* ~ ")"
}

require_list = {
    require_item ~ ("," ~ require_item)*
}

require_item = {
    dotted_ident ~ ("(" ~ ident ~ ("," ~ ident)* ~ ")")?
}

not_kw = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
and_kw = { "and" }
or_kw  = { "or" }
dot = { "." }

compare_op = { ">=" | "<=" | ">" | "<" }     // NO == or !=
add_op     = { "+" | "-" }
mul_op     = { "*" | "/" }
unary_minus = { "-" }

// Unified expression tower: used by both policy conditions and transition conditions.
// Backward-compatible: existing policy expressions parse identically.

policy_expr = { or_expr }

or_expr   = { and_expr ~ (or_kw ~ and_expr)* }
and_expr  = { not_expr ~ (and_kw ~ not_expr)* }
not_expr  = { not_kw* ~ compare_expr }
compare_expr = { add_expr ~ compare_op ~ add_expr | add_expr }
add_expr  = { mul_expr ~ (add_op ~ mul_expr)* }
mul_expr  = { unary_expr ~ (mul_op ~ unary_expr)* }
unary_expr = { unary_minus* ~ primary }

primary = {
    "(" ~ or_expr ~ ")"
    | call_or_in
    | node_ref
    | number_literal
    | policy_ref
}

policy_ref = { !dot ~ ident }

node_ref = { ident ~ "." ~ ident }

number_literal = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

call_or_in = {
    ident ~ (
        dot ~ ident ~ "(" ~ policy_arg_list? ~ ")"
        | "in" ~ policy_array
    )
}

policy_arg_list = { policy_value ~ ("," ~ policy_value)* }
policy_array  = { "[" ~ policy_value ~ ("," ~ policy_value)* ~ "]" }
policy_value  = { number_literal | single_line_string | ident }

stage = {
    "stage" ~ annotation? ~ ident ~ "{" ~
    stage_body_item* ~
    "}"
}

annotation = @{ "@" ~ ident }

stage_body_item = {
    transition_block | prompt_decl | stage_input | output_block | requires_block | exec_decl
}

transition_block = {
    (transition_decl ~ ","?)+
}

transition_decl = { "transition" ~ (transition_cond | transition_else) ~ "=>" ~ ident }
transition_cond = { "if" ~ or_expr }
transition_else = { "else" }

prompt_decl = {
    "prompt" ~ ":" ~ string
}

stage_input = {
    "input" ~ ":" ~ input_ref ~ ("," ~ input_ref)*
}

input_ref = {
    ident ~ "." ~ ident ~ optional_marker?
}

output_block = {
    "output" ~ ":" ~ "{" ~
    output_field* ~
    "}"
}

output_field = {
    ident ~ ":" ~ type_ref ~ bool_branches?
}

bool_branches = {
    "{" ~ "true" ~ "=>" ~ ident ~ "false" ~ "=>" ~ ident ~ "}"
}

requires_block = {
    "requires" ~ ":" ~ dotted_ident ~ ("," ~ dotted_ident)*
}

exec_decl = {
    "exec" ~ ":" ~ dotted_ident ~ "(" ~ exec_arg_list? ~ ")"
}

exec_arg_list = { exec_arg ~ ("," ~ exec_arg)* }
exec_arg = { ident ~ ":" ~ exec_value }
exec_value = { single_line_string | ident ~ ("." ~ ident)? }

string = { multiline_string | single_line_string }

single_line_string = @{
    "\"" ~ ( "\\\"" | !("\"" | "\n" | "\r") ~ ANY )* ~ "\""
}

multiline_string = @{
    "\"\"\"" ~ ( !"\"\"\"" ~ ANY )* ~ "\"\"\""
}
