{
  "name": "nemoir-web-interview-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "compile:workflows": "node ./scripts/compile-workflows.mjs",
    "dev": "vite",
    "dev:regenerate": "npm run compile:workflows && vite",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck:generated && vite build",
    "preview": "vite preview",
    "typecheck": "npm run compile:workflows && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:generated": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@monaco-editor/react": "^4.7.0",
    "@nemoir/compiler-wasm": "^0.1.8",
    "@nemoir/web-runtime": "^0.5.0",
    "@nemoir/web-ui": "^0.3.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
