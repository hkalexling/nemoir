// Evidence-backed, local WebLLM tutoring workflow.
//
// This workflow deliberately has no sandbox capability: learner code is
// evaluated only by InterviewTestRunner. The tutor receives the immutable
// source/report snapshot from that deterministic run and produces guidance
// from the evidence. Browser storage is limited to a compact pedagogical
// profile; it never stores learner source, public tests, or full hints.
workflow InterviewTutor {
  input {
    // The app supplies one bounded, JSON-safe immutable snapshot. A single
    // JSON input lets the deterministic entry stage preserve the request for
    // downstream stages; DSL stage inputs currently reference prior outputs.
    tutor_request: json
  }

  // Capture and validate the app-built snapshot without evaluating learner
  // source. This is trusted workflow-author code processing JSON data only.
  stage@entry CaptureRequest {
    exec: browser.js.run(
      code: """
function isRecord(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function isJsonSafe(value, seen) {
  if (value === null) return true;
  var type = typeof value;
  if (type === "string" || type === "boolean") return true;
  if (type === "number") return Number.isFinite(value);
  if (type !== "object") return false;
  if (!seen) seen = new WeakSet();
  if (seen.has(value)) return false;
  seen.add(value);
  if (Array.isArray(value)) {
    for (var i = 0; i < value.length; i++) {
      if (!isJsonSafe(value[i], seen)) return false;
    }
    return true;
  }
  var proto = Object.getPrototypeOf(value);
  if (proto !== Object.prototype && proto !== null) return false;
  var keys = Object.keys(value);
  for (var j = 0; j < keys.length; j++) {
    if (!isJsonSafe(value[keys[j]], seen)) return false;
  }
  return true;
}

function requiredText(value, label, maxLength) {
  if (typeof value !== "string" || value.length === 0 || value.length > maxLength) {
    throw new Error(label + " must be a non-empty string no longer than " + maxLength + " characters");
  }
  return value;
}

if (!isRecord(input)) {
  throw new Error("Tutor request must be an object");
}

var hintLevel = requiredText(input.hintLevel, "hintLevel", 16);
if (hintLevel !== "nudge" && hintLevel !== "targeted" && hintLevel !== "plan" && hintLevel !== "review") {
  throw new Error("hintLevel must be nudge, targeted, plan, or review");
}
if (!isRecord(input.runReport) || typeof input.runReport.status !== "string") {
  throw new Error("runReport must include a status");
}
var reportStatus = input.runReport.status;
if (
  reportStatus !== "passed" && reportStatus !== "failed" &&
  reportStatus !== "syntax_error" && reportStatus !== "runtime_error" &&
  reportStatus !== "timeout"
) {
  throw new Error("runReport has an unsupported status");
}
if ((hintLevel === "review") !== (reportStatus === "passed")) {
  throw new Error("review is required only for a passed run report");
}
if (!isJsonSafe(input.runReport) || !isJsonSafe(input.priorSummary) || !isJsonSafe(input.problemMetadata)) {
  throw new Error("Tutor request JSON fields must be JSON-safe");
}

// Keep profile persistence deterministic and deliberately minimal. A local
// model should diagnose the attempt, not be required to manufacture storage
// bookkeeping before it can return a hint.
function profileSeed(metadata, report) {
  var rawMetadata = isRecord(metadata) ? metadata : {};
  var rawTopics = Array.isArray(rawMetadata.topics) ? rawMetadata.topics : [];
  var topics = [];
  var seen = Object.create(null);
  var didPass = report.status === "passed" ? 1 : 0;

  for (var i = 0; i < rawTopics.length && topics.length < 8; i++) {
    var rawTopic = rawTopics[i];
    if (typeof rawTopic !== "string") continue;
    var topic = rawTopic.replace(/\s+/g, " ").trim();
    if (!topic || topic.length > 48 || seen[topic]) continue;
    seen[topic] = true;
    topics.push({
      topic: topic,
      attempts: 1,
      passed: didPass,
      concepts: []
    });
  }

  return { version: 1, topics: topics, recentConcepts: [] };
}

// Emit individual flat fields so model stages receive flat readable context
// (mirrors the web-hints demo) instead of one nested JSON blob small models
// can't hold in their attention window.
return {
  problemContext: requiredText(input.problemContext, "problemContext", 12000),
  learnerCode: requiredText(input.learnerCode, "learnerCode", 24000),
  runReport: input.runReport,
  hintLevel: hintLevel,
  priorSummary: input.priorSummary,
  problemMetadata: input.problemMetadata,
  profile_seed: profileSeed(input.problemMetadata, input.runReport)
};
""",
      input: tutor_request
    )
    output: {
      problemContext: string
      learnerCode: string
      runReport: json
      hintLevel: string
      priorSummary: json
      problemMetadata: json
      profile_seed: json
    }
  }

  // Storage is deliberately workflow-owned and namespaced by the runtime.
  // A missing key returns `{ found: false, value: null }`.
  stage LoadProfile {
    exec: browser.storage.read(key: "learner-profile-v1")
    output: {
      found: bool
      value: json
    }
  }

  stage DiagnoseAttempt {
    // Flat fields mirror the web-hints demo pattern: the model sees simple
    // top-level context keys instead of one deeply nested JSON blob.
    input: CaptureRequest.problemContext, CaptureRequest.learnerCode,
      CaptureRequest.runReport, CaptureRequest.hintLevel,
      CaptureRequest.priorSummary, LoadProfile.found, LoadProfile.value?
    prompt: """
You are a Socratic JavaScript coding-interview tutor. Read the problem
context, the learner's code, and the run report. Identify the most likely
bug and state it concisely (one or two sentences). Decide whether you need
to ask the learner a clarifying question before giving a hint.
"""
    output: {
      needs_clarify: bool { true => AskClarify false => NormalizeProfile }
      diagnosis: string
    }
  }

  stage AskClarify {
    input: DiagnoseAttempt.diagnosis
    prompt: """
The deterministic evidence is not sufficient for a high-quality Socratic
hint. Call the `elicit` tool exactly once with one short, focused question
about the learner's reasoning. Do not reveal a fix, code, or a full algorithm.
After the learner responds, return their response as `clarification`.
You MUST call `elicit`; do not substitute the question for the learner answer.
"""
    output: {
      clarification: string
    }
    // This is the only model stage that can interact with the learner.
    requires: user.elicit
  }

  // Deterministic profile metadata from the validated request is normalized
  // by reviewed, compile-time literal author code before it reaches browser
  // storage. This worker never evaluates learner or model source.
  stage NormalizeProfile {
    exec: browser.js.run(
      code: """
function isRecord(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function cleanText(value, maxLength) {
  if (typeof value !== "string") return null;
  var text = value.replace(/\s+/g, " ").trim();
  if (!text || text.length > maxLength) return null;
  return text;
}

function cleanCounter(value) {
  if (typeof value !== "number" || !Number.isFinite(value)) return 0;
  return Math.max(0, Math.min(100000, Math.floor(value)));
}

function cleanLabels(value, maxItems, maxLength) {
  if (!Array.isArray(value)) return [];
  var result = [];
  var seen = Object.create(null);
  for (var i = 0; i < value.length && result.length < maxItems; i++) {
    var label = cleanText(value[i], maxLength);
    if (label && !seen[label]) {
      seen[label] = true;
      result.push(label);
    }
  }
  return result;
}

var candidate = isRecord(input) ? input : {};
var rawTopics = Array.isArray(candidate.topics) ? candidate.topics : [];
var topics = [];
var seenTopics = Object.create(null);

for (var i = 0; i < rawTopics.length && topics.length < 12; i++) {
  var raw = rawTopics[i];
  if (!isRecord(raw)) continue;
  var topic = cleanText(raw.topic, 48);
  if (!topic || seenTopics[topic]) continue;
  seenTopics[topic] = true;
  var attempts = cleanCounter(raw.attempts);
  var passed = Math.min(attempts, cleanCounter(raw.passed));
  topics.push({
    topic: topic,
    attempts: attempts,
    passed: passed,
    concepts: cleanLabels(raw.concepts, 8, 96)
  });
}

return {
  profile: {
    version: 1,
    topics: topics,
    recentConcepts: cleanLabels(candidate.recentConcepts, 8, 96)
  }
};
""",
      input: CaptureRequest.profile_seed
    )
    output: {
      profile: json
    }
  }

  stage SaveProfile {
    exec: browser.storage.write(
      key: "learner-profile-v1",
      value: NormalizeProfile.profile
    )
    output: {
      key: string
      written: bool
    }
  }

  // Keep this model stage as the typed workflow exit. The runtime returns the
  // terminal stage's output, while browser.storage.write returns only
  // `{ key, written }`; persisting immediately before this stage preserves a
  // clean AgentOutput without hand-editing generated artifacts.
  stage@exit ProduceGuidance {
    input: CaptureRequest.problemContext, CaptureRequest.learnerCode,
      CaptureRequest.runReport, CaptureRequest.hintLevel,
      DiagnoseAttempt.diagnosis, AskClarify.clarification?,
      NormalizeProfile.profile
    prompt: """
You are a Socratic JavaScript coding-interview tutor. Using the problem
context, the learner's code, the run report, the diagnosis, and any
clarification, produce a Socratic hint that guides the learner toward the fix
without revealing the solution. Be friendly and specific. Do not include the
repaired code.

If the run report passed, discuss complexity, robustness, or a next challenge
instead of pretending there is a bug. Honor the hint level: "nudge" gives
conceptual direction only; "targeted" identifies the relevant region to
inspect; "plan" gives high-level pseudocode, never a complete implementation.

Return exactly:
- hint: concise learner-facing Socratic guidance;
- concept: one short central concept;
- next_steps: two to four concrete learner actions. If you are unsure, the host
  adds safe generic follow-up actions.

The shape is
{"hint":"...","concept":"...","next_steps":["...","..."]}
"""
    output: {
      mode: string?
      hint: string
      concept: string
      next_steps: string[]?
    }
  }
}
