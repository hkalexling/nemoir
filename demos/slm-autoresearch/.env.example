# Copy to .env and fill in a provider key for real campaigns.
# Fake-model tests and the harness test suite need no provider at all.
NEMOIR_MODEL=openai/gpt-4o-mini
NEMOIR_API_KEY=
# NEMOIR_API_BASE=https://your-openai-compatible-endpoint/v1
# For muse-spark via opencode (responses API, not chat completions):
# NEMOIR_MODEL=openai/muse-spark-1.2-contributor
# NEMOIR_MODEL_API=responses
# NEMOIR_API_BASE=https://opencode.ai/zen/go/v1
# Legacy DeepSeek key also works:
# DEEPSEEK_API_KEY=
