workflow HintTutor {
  input {
    task: string
    learner_code: string
    failure_report: string
  }

  // The entry stage implicitly reads all workflow inputs (task, learner_code,
  // failure_report). Downstream stages compose from this stage's outputs.
  stage@entry Diagnose {
    prompt: """
      You are a Socratic programming tutor. Read the problem, the learner's code, and
      any failure report (it may be empty). Identify the most likely bug and state it
      concisely (one or two sentences). Decide whether you need to ask the learner a
      clarifying question before giving a hint.
    """
    output: {
      needs_clarify: bool { true => AskClarify false => Hint }
      suspected_bug: string
    }
  }

  stage AskClarify {
    prompt: """
      You need more information before you can give a good hint. Call the `elicit` tool
      to ask the learner ONE focused clarifying question about the suspected bug. Do not
      reveal the fix or any code. Be Socratic and friendly.
      After the learner responds, record THEIR answer (not your question) as the
      `clarification` output. You MUST call the `elicit` tool — do not write the
      question yourself as the output.
    """
    // suspected_bug is non-optional, so AskClarify only runs when needs_clarify is true
    input: Diagnose.suspected_bug
    output: {
      clarification: string
    }
    requires: user.elicit
  }

  stage Hint {
    prompt: """
      Using the suspected bug and the learner's clarification (their answer to your
      clarifying question, if you asked one), produce:
      (1) a concise list of diagnostic key points (each a short sentence), and
      (2) a single Socratic hint that guides the learner toward the fix WITHOUT revealing
      the solution. Be friendly and specific. Do not include the repaired code.
    """
    input: Diagnose.suspected_bug, AskClarify.clarification?
    output: {
      key_points: string[]
      hint: string
    }
  }

  stage@exit Done {
    prompt: "Return the final hint and key points to the learner."
    input: Hint.hint, Hint.key_points
    output: {
      hint: string
      key_points: string[]
    }
  }
}
